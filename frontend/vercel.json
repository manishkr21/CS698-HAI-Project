{
    "builds": [
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "https://cdis.iitk.ac.in/student_app"
        },
        {
            "src": "^/CS698-HAI-Project/assets/(.*)\\.js$",
            "headers": {
                "Content-Type": "application/javascript"
            },
            "dest": "/assets/$1.js"
        },
        {
            "src": "^/CS698-HAI-Project/assets/(.*)\\.css$",
            "headers": {
                "Content-Type": "text/css"
            },
            "dest": "/assets/$1.css"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/CS698-HAI-Project/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}